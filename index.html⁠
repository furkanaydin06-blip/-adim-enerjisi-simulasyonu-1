<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Footstep Power Generation Simulator</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --panel-bg: #1e293b;
            --border-color: #334155;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent: #38bdf8;
            --piezo-color: #f59e0b;
            --lcd-bg: #14532d;
            --lcd-text: #4ade80;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }

        header {
            text-align: center;
            margin-bottom: 20px;
        }

        h1 {
            font-size: 22px;
            color: var(--accent);
            margin: 0 0 5px 0;
        }

        p.subtitle {
            color: var(--text-muted);
            font-size: 13px;
            margin: 0;
        }

        .sim-container {
            background-color: var(--panel-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 20px;
            width: 100%;
            max-width: 850px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        /* Üst Bölüm: Devre Blokları */
        .circuit-board {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        @media(max-width: 768px) {
            .circuit-board { grid-template-columns: 1fr; }
        }

        .block {
            background-color: var(--bg-color);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 15px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .block-title {
            font-size: 13px;
            font-weight: bold;
            color: var(--accent);
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 5px;
        }

        /* Piezo ve Adım Butonu */
        .piezo-area {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .piezo-nodes {
            display: flex;
            gap: 6px;
        }

        .piezo-disk {
            width: 32px;
            height: 32px;
            background: #334155;
            border: 2px solid var(--piezo-color);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            font-weight: bold;
            color: var(--piezo-color);
            transition: 0.1s;
        }

        .piezo-disk.active {
            background: var(--piezo-color);
            color: #000;
            box-shadow: 0 0 12px var(--piezo-color);
            transform: scale(1.1);
        }

        .step-btn {
            background: linear-gradient(135deg, #f97316, #ea580c);
            color: white;
            border: none;
            padding: 12px 20px;
            font-size: 15px;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(249, 115, 22, 0.4);
            transition: 0.1s;
            width: 100%;
            text-align: center;
        }

        .step-btn:active {
            transform: scale(0.97);
            background: linear-gradient(135deg, #ea580c, #c2410c);
        }

        /* LCD Ekran */
        .lcd-screen {
            background-color: var(--lcd-bg);
            border: 3px solid #166534;
            border-radius: 6px;
            padding: 12px;
            font-family: 'Courier New', Courier, monospace;
            font-size: 15px;
            color: var(--lcd-text);
            box-shadow: inset 0 0 10px rgba(0,0,0,0.8);
            letter-spacing: 1px;
        }

        .lcd-line {
            margin: 4px 0;
            white-space: pre;
        }

        /* Metrik Göstergeleri */
        .metrics-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .metric-card {
            background-color: var(--bg-color);
            border: 1px solid var(--border-color);
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 12px;
        }

        .metric-val {
            font-size: 14px;
            font-weight: bold;
            color: var(--accent);
            margin-top: 3px;
        }

        /* Terminal Log Paneli */
        .terminal {
            background-color: #090d16;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 10px;
            height: 90px;
            overflow-y: auto;
            font-family: monospace;
            font-size: 11px;
            color: #cbd5e1;
        }
    </style>
</head>
<body>

    <header>
        <h1>Footstep Power Generation System</h1>
        <p class="subtitle">Arduino & Piezoelectric Energy Harvesting Simulator</p>
    </header>

    <div class="sim-container">
        
        <div class="circuit-board">
            
            <!-- Sol Blok: Fiziksel Giriş & Piezo -->
            <div class="block">
                <div class="block-title">1. Piezo Sensör Matrisi (Giriş)</div>
                <div class="piezo-area">
                    <span style="font-size: 12px; color: var(--text-muted);">6'lı Piezo Dizisi:</span>
                    <div class="piezo-nodes">
                        <div class="piezo-disk p-node">P1</div>
                        <div class="piezo-disk p-node">P2</div>
                        <div class="piezo-disk p-node">P3</div>
                        <div class="piezo-disk p-node">P4</div>
                        <div class="piezo-disk p-node">P5</div>
                        <div class="piezo-disk p-node">P6</div>
                    </div>
                </div>
                
                <button class="step-btn" onclick="triggerStep()">👣 ADIM AT (BAS)</button>

                <div class="metrics-grid">
                    <div class="metric-card">
                        <div>Doğrultma (Köprü):</div>
                        <div class="metric-val" id="bridgeState" style="color: #fbbf24;">Beklemede</div>
                    </div>
                    <div class="metric-card">
                        <div>Arduino A0 Voltajı:</div>
                        <div class="metric-val" id="voltState">0.00 V</div>
                    </div>
                </div>
            </div>

            <!-- Sağ Blok: LCD ve Çıkış -->
            <div class="block">
                <div class="block-title">2. I²C 16x2 LCD Ekran (Gösterge)</div>
                <div class="lcd-screen" id="lcd">
                    <div class="lcd-line">Toplam Adim: 0  </div>
                    <div class="lcd-line">Guc: 0 mW       </div>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 12px; margin-top: 5px;">
                    <span>12V LED Şerit Durumu:</span>
                    <span id="ledBadge" style="background: #7f1d1d; color: #fca5a5; padding: 3px 8px; border-radius: 4px; font-weight: bold;">PASİF</span>
                </div>
            </div>

        </div>

        <!-- Alt Blok: Sistem Logları -->
        <div class="block">
            <div class="block-title">3. Seri Port / Sistem Logları</div>
            <div class="terminal" id="terminal">
                [00:00:01] Sistem başlatıldı. Analog A0 pin dinleniyor...<br>
                [00:00:01] I2C LCD ekran (0x27) hazır durumda.<br>
            </div>
        </div>

    </div>

    <script>
        let stepCount = 0;
        let totalPower = 0;

        function triggerStep() {
            stepCount++;
            totalPower += 15; // Her adımda üretilen ortalama enerji birimi (mW)

            // Rastgele tepe voltajı simülasyonu (3.5V - 4.8V arası)
            let voltage = (Math.random() * (4.8 - 3.5) + 3.5).toFixed(2);

            // Piezo animasyonu
            const disks = document.querySelectorAll('.piezo-disk');
            disks.forEach(d => d.classList.add('active'));

            // Panel durumları
            document.getElementById('bridgeState').innerText = "DC Aktif";
            document.getElementById('bridgeState').style.color = "#4ade80";
            document.getElementById('voltState').innerText = voltage + " V";

            // LED şerit aktif
            let badge = document.getElementById('ledBadge');
            badge.innerText = "AKTİF (YANIYOR)";
            badge.style.background = "#14532d";
            badge.style.color = "#4ade80";

            // LCD Güncelleme
            let stepsPadded = String(stepCount).padEnd(3, ' ');
            let powerPadded = String(totalPower).padEnd(4, ' ');
            document.getElementById('lcd').innerHTML = `
                <div class="lcd-line">Toplam Adim: ${stepsPadded}</div>
                <div class="lcd-line">Guc: ${powerPadded} mW   </div>
            `;

            // Terminal Log Ekleme
            let term = document.getElementById('terminal');
            let timeStr = new Date().toLocaleTimeString();
            term.innerHTML += `[${timeStr}] Adım algılandı! Sayaç: ${stepCount} | Güç: ${totalPower}mW<br>`;
            term.scrollTop = term.scrollHeight;

            // Kısa süre sonra sinyali sıfırla (darbe etkisi)
            setTimeout(() => {
                disks.forEach(d => d.classList.remove('active'));
                document.getElementById('bridgeState').innerText = "Beklemede";
                document.getElementById('bridgeState').style.color = "#fbbf24";
                document.getElementById('voltState').innerText = "0.00 V";
                badge.innerText = "PASİF";
                badge.style.background = "#7f1d1d";
                badge.style.color = "#fca5a5";
            }, 180);
        }
    </script>
</body>
</html>
